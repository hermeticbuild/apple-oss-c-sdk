# macOS versions needed by the 26.5 availability headers after the public
# AvailabilityVersions-157.2 table ends at 14.3.
# https://github.com/apple-oss-distributions/AvailabilityVersions/blob/149b1777f3e8c2133042d8e188f72e3adf6a7110/availability.dsl
# Apple release histories:
# https://support.apple.com/en-us/109035
# https://support.apple.com/en-us/120283
# https://support.apple.com/en-us/122868
# https://developer.apple.com/documentation/macos-release-notes/macos-26_5-release-notes
version macos 14.4
version macos 14.5
version macos 14.6
version macos 14.7
version macos 15.0
version macos 15.1
version macos 15.2
version macos 15.3
version macos 15.4
version macos 15.5
version macos 15.6
# Apple's Xcode 26 release notes also refer to the 16.0 compatibility number.
# https://developer.apple.com/documentation/xcode-release-notes/xcode-26-release-notes?changes=la_5__7_1
version macos 16.0
version macos 26.0
version macos 26.1
version macos 26.2
version macos 26.3
version macos 26.4
version macos 26.5
