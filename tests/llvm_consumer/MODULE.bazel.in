module(name = "apple_oss_c_sdk_consumer")
bazel_dep(name = "llvm", version = "")
local_path_override(module_name = "llvm", path = "@LLVM_REPO@")
bazel_dep(name = "rules_cc", version = "0.2.25")

osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.from_archive(
    urls = ["file://@ARCHIVE@"],
    sha256 = "@SHA256@",
    strip_prefix = "MacOSX.sdk",
    type = "tar.zst",
)
use_repo(osx, "macos_sdk")

llvm_toolchains = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
use_repo(llvm_toolchains, "llvm_toolchains")
register_toolchains("@llvm_toolchains//:all")

llvm_source = use_extension("@llvm//extensions:llvm.bzl", "llvm")
use_repo(llvm_source, "llvm-project")
